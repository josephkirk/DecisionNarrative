{
  "name": "decisionnarrative-storylet-studio",
  "version": "1.0.0",
  "description": "Local authoring and playtest studio for non-linear storylet-driven narrative games",
  "type": "module",
  "scripts": {
    "play": "bun run src/web/server.ts",
    "engine:service": "cargo run --manifest-path crates/storylet-engine-service/Cargo.toml --bin storylet-engine-service",
    "smoke:semantic-director": "bun run scripts/smoke-semantic-director.ts",
    "smoke:native-host": "pwsh -NoProfile -File scripts/run-native-host.ps1",
    "test": "bun test",
    "bench": "cargo run --release --manifest-path crates/storylet-engine/Cargo.toml --bin storylet-engine-bench --",
    "build": "bun run scripts/build.ts",
    "serve": "bun run src/web/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "1.3.14"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1"
  }
}
