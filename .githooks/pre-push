#!/bin/sh
# Install this file as .git/hooks/pre-push; retain other existing Git hooks.
# This hook only queues detached local review tasks; it never waits for a review.

local_data=${LOCALAPPDATA:-"$HOME/AppData/Local"}
if command -v cygpath >/dev/null 2>&1; then
  converted=$(cygpath -u "$local_data" 2>/dev/null)
  if [ -n "$converted" ]; then local_data=$converted; fi
fi
log_dir="$local_data/DecisionNarrative/local-review"
log_file="$log_dir/review.log"
mkdir -p "$log_dir" 2>/dev/null || :

if command -v bun >/dev/null 2>&1; then
  if bun run scripts/local-review/pre-push.ts "$@" >>"$log_file" 2>&1; then
    :
  else
    bun_status=$?
    printf '[%s] hook launcher: Bun/local dispatcher failed (exit %s); allowing push\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf unknown)" "$bun_status" >>"$log_file" 2>/dev/null || :
  fi
else
  printf '[%s] hook launcher: Bun was not found; allowing push\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf unknown)" >>"$log_file" 2>/dev/null || :
fi

exit 0
